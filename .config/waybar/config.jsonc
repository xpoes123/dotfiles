[
{
    "output": "HDMI-A-1",
    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 0,
    "margin-top": 6,
    "margin-left": 8,
    "margin-right": 8,
    "exclusive": true,

    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["hyprland/window"],
    "modules-right": ["custom/claude-usage", "cpu", "memory", "temperature", "clock"],

    "hyprland/workspaces": {
        "format": "{id}",
        "on-click": "activate",
        "active-only": false,
        "sort-by-number": true
    },

    "hyprland/window": {
        "max-length": 60,
        "separate-outputs": true,
        "rewrite": {
            "(.*) — Mozilla Firefox": "$1",
            "(.*) - Brave": "$1"
        }
    },

    "cpu": {
        "format": "  {usage}%",
        "interval": 2,
        "tooltip": false
    },

    "memory": {
        "format": "  {percentage}%",
        "interval": 5,
        "tooltip": false
    },

    "temperature": {
        "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
        "format": "  {temperatureC}°",
        "critical-threshold": 85,
        "interval": 5,
        "tooltip": false
    },

    "clock": {
        "format": "  {:%H:%M}",
        "format-alt": "  {:%a %d %b}",
        "tooltip-format": "<tt>{calendar}</tt>",
        "interval": 60
    },

    "custom/claude-usage": {
        "exec": "~/.local/bin/claude-usage",
        "return-type": "json",
        "interval": 300,
        "tooltip": true
    }
},
{
    "output": "DP-1",
    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 0,
    "margin-top": 6,
    "margin-left": 8,
    "margin-right": 8,
    "exclusive": true,

    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["hyprland/window"],
    "modules-right": ["custom/claude-usage", "cpu", "memory", "temperature", "clock"],

    "hyprland/workspaces": {
        "format": "{id}",
        "on-click": "activate",
        "active-only": false,
        "sort-by-number": true
    },

    "hyprland/window": {
        "max-length": 60,
        "separate-outputs": true,
        "rewrite": {
            "(.*) — Mozilla Firefox": "$1",
            "(.*) - Brave": "$1"
        }
    },

    "cpu": {
        "format": "  {usage}%",
        "interval": 2,
        "tooltip": false
    },

    "memory": {
        "format": "  {percentage}%",
        "interval": 5,
        "tooltip": false
    },

    "temperature": {
        "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
        "format": "  {temperatureC}°",
        "critical-threshold": 85,
        "interval": 5,
        "tooltip": false
    },

    "clock": {
        "format": "  {:%H:%M}",
        "format-alt": "  {:%a %d %b}",
        "tooltip-format": "<tt>{calendar}</tt>",
        "interval": 60
    },

    "custom/claude-usage": {
        "exec": "~/.local/bin/claude-usage",
        "return-type": "json",
        "interval": 300,
        "tooltip": true
    }
}
]
