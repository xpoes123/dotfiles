[
{
    "output": "HDMI-A-1",
    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 0,
    "margin-top": 6,
    "margin-left": 8,
    "margin-right": 8,
    "exclusive": true,

    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["hyprland/window"],
    "modules-right": ["custom/music", "custom/claude-usage", "custom/gpu", "cpu", "memory", "disk", "temperature", "clock"],

    "hyprland/workspaces": {
        "format": "{id}",
        "on-click": "activate",
        "active-only": false,
        "sort-by-number": true
    },

    "hyprland/window": {
        "max-length": 60,
        "separate-outputs": true,
        "rewrite": {
            "(.*) — Mozilla Firefox": "$1",
            "(.*) - Brave": "$1"
        }
    },

    "cpu": {
        "format": "cpu {usage}",
        "interval": 2,
        "tooltip-format": "CPU utilization: {usage}%\nLoad: {load}"
    },

    "memory": {
        "format": "ram {percentage}",
        "interval": 5,
        "tooltip-format": "RAM: {used:0.1f}GiB used / {total:0.1f}GiB total"
    },

    "disk": {
        "format": "ssd {percentage_used}",
        "interval": 30,
        "tooltip-format": "Disk: {used} used / {total} total ({free} free)"
    },

    "temperature": {
        "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
        "format": "{temperatureC}°",
        "critical-threshold": 85,
        "interval": 5,
        "tooltip-format": "CPU temperature: {temperatureC}°C"
    },

    "clock": {
        "format": "  {:%H:%M}",
        "format-alt": "  {:%a %d %b}",
        "tooltip-format": "<tt>{calendar}</tt>",
        "interval": 60
    },

    "custom/claude-usage": {
        "exec": "~/.local/bin/claude-usage",
        "return-type": "json",
        "interval": 300,
        "tooltip": true
    },

    "custom/gpu": {
        "exec": "~/.local/bin/waybar-gpu",
        "return-type": "json",
        "interval": 2,
        "tooltip": true
    },

    "custom/music": {
        "exec": "~/.local/bin/waybar-music",
        "return-type": "json",
        "interval": 3,
        "tooltip": true
    }
},
{
    "output": "DP-1",
    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 0,
    "margin-top": 6,
    "margin-left": 8,
