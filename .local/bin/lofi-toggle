#!/usr/bin/env bash
# Toggle music. Plays random tracks across all genre folders in ~/music.
# Pass a genre name (e.g. "lofi" or "vaporwave") to restrict to that folder.

MUSIC_ROOT="$HOME/music"
LOCK_FILE="/tmp/music-mode.lock"
NOW_FILE="/tmp/music-now-playing"

if [[ -n "$1" ]]; then
    SEARCH_DIR="$MUSIC_ROOT/$1"
else
    SEARCH_DIR="$MUSIC_ROOT"
fi

kill_music_mpv() {
    local pids
    pids=$(pgrep -f "mpv.*$HOME/music/")
    [[ -n "$pids" ]] && kill -9 $pids 2>/dev/null
}

if [[ -f "$LOCK_FILE" ]]; then
    rm -f "$LOCK_FILE" "$NOW_FILE"
    kill_music_mpv
    exit 0
fi

# Starting fresh
kill_music_mpv
rm -f "$NOW_FILE"
sleep 0.2

touch "$LOCK_FILE"

(
    first=1
    while [[ -f "$LOCK_FILE" ]]; do
        file=$(find "$SEARCH_DIR" -type f \( -iname "*.mp3" -o -iname "*.m4a" -o -iname "*.opus" -o -iname "*.webm" \) | shuf -n 1)
        [[ -z "$file" ]] && sleep 5 && continue

        echo "$file" > "$NOW_FILE"

        if [[ $first -eq 1 ]]; then
            start=$((RANDOM % 75))
            mpv --no-video --start="${start}%" "$file"
            first=0
        else
            mpv --no-video "$file"
        fi
    done
    rm -f "$NOW_FILE"
) &
disown
