#!/usr/bin/env bash
# Toggle ambient video mode.
# First press: save current workspace, switch main monitor to ws 99, play video fullscreen.
# Second press: kill video, restore workspace.

LOCK_FILE="/tmp/ambient-mode.lock"
WORKSPACE_FILE="/tmp/ambient-workspace"

if [[ -f "$LOCK_FILE" ]]; then
    rm "$LOCK_FILE"
    kill -9 $(pgrep mpv) 2>/dev/null
    kill -9 $(pgrep -f video-wallpaper) 2>/dev/null

    # Restore saved workspace
    saved=$(cat "$WORKSPACE_FILE" 2>/dev/null || echo "1")
    hyprctl dispatch workspace "$saved"
else
    # Hard kill any stale instances
    kill -9 $(pgrep mpv) 2>/dev/null
    kill -9 $(pgrep -f video-wallpaper) 2>/dev/null
    sleep 0.3

    # Save current workspace
    hyprctl monitors -j | python3 -c "
import json, sys
monitors = json.load(sys.stdin)
focused = next((m for m in monitors if m['focused']), monitors[0])
print(focused['activeWorkspace']['id'])
" > "$WORKSPACE_FILE" 2>/dev/null || echo "1" > "$WORKSPACE_FILE"

    touch "$LOCK_FILE"

    # Switch to workspace 99 and start the video loop
    hyprctl dispatch workspace 99
    /home/david/.local/bin/video-wallpaper &
fi
