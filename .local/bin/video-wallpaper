#!/usr/bin/env bash
# Play ambient video using fullscreen mpv (direct scanout — bypasses compositor).
# Much lower GPU usage than mpvpaper which renders as a compositor layer.

VIDEO_DIR="$HOME/wallpapers/videos"

# Hard kill any existing instances
kill -9 $(pgrep -f "mpv.*wallpaper\|mpvpaper") 2>/dev/null
sleep 0.3

pick_random() {
    find "$VIDEO_DIR" -type f \( -iname "*.mp4" -o -iname "*.mkv" -o -iname "*.webm" \) | shuf -n 1
}

# Play videos in a loop, picking a new one each time
while [[ -f /tmp/ambient-mode.lock ]]; do
    video=$(pick_random)
    [[ -z "$video" ]] && sleep 5 && continue
    mpv --fullscreen \
        --no-audio \
        --no-osc \
        --no-osd-bar \
        --loop-file=no \
        --hwdec=nvdec \
        --gpu-api=vulkan \
        --title="ambient-video" \
        "$video"
done
